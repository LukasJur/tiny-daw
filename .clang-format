--- # Approximates JUCE's own coding style: Allman braces for
    # classes/functions/namespaces, attached braces for control flow,
    # space before parens, 4-space indent.
BasedOnStyle: LLVM
Language: Cpp

IndentWidth: 4
UseTab: Never
ColumnLimit: 120

BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: false
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeElse: false
  BeforeCatch: false
  SplitEmptyFunction: false

SpaceBeforeParens: Always
PointerAlignment: Left
ReferenceAlignment: Left
AccessModifierOffset: -4
NamespaceIndentation: None

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
SortIncludes: false
